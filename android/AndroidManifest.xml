<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.qtproject.example"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <!-- Explicit network permissions for HTTPS (update check, addon index). Qt also inserts
         INTERNET via %%INSERT_PERMISSIONS%%; listing them here keeps the requirement visible. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Media import uses the Storage Access Framework (QFileDialog → ACTION_OPEN_DOCUMENT).
         Do not add READ_MEDIA_* / READ_EXTERNAL_STORAGE for import — access is granted per
         content:// URI when the user picks a file. Qt may still inject legacy storage
         permissions via %%INSERT_PERMISSIONS%%; they are unused by the import path. -->
    <!-- The compositor creates an ES 3.0 context (GlRuntime::initGlObjects) and every shader is
         translated to #version 300 es. There is no ES 2.0 fallback path, so declaring this as
         required is honest: on an ES2-only device the preview would fail to initialise. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="-- %%INSERT_APP_ICON%% --"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="false"
        android:largeHeap="true"
        android:allowBackup="true"
        android:fullBackupOnly="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="-- %%INSERT_APP_NAME%% --"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/DriftTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open a .drift project from a file manager or a share sheet. There is no
                 registered MIME type for the format, so match on the extension: the
                 pathPattern trick below is the documented way to say "*.drift" — Android
                 treats `.` literally in pathPattern and `*` as "zero or more of the
                 preceding", so each entry covers one more literal dot in the name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.drift" />
                <data android:pathPattern=".*\\..*\\.drift" />
                <data android:pathPattern=".*\\..*\\..*\\.drift" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <!-- Qt-managed splash while native + QML boot. Cleared automatically once
               the first frame is ready (non-sticky). -->
          <meta-data
                android:name="android.app.splash_screen_drawable"
                android:resource="@drawable/splash_screen" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
